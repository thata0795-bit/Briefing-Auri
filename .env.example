# Copie para .env.local e preencha. Nunca grave chaves reais no repositório.

# Endereço público do sistema (usado nos links dos e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API). Em ambiente local, rode `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: só no servidor. Nunca use NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY=
# Conexão direta ao Postgres, usada pelos testes de RLS
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# E-mail: com RESEND_API_KEY os e-mails saem pelo Resend; sem ela, pelo SMTP abaixo
RESEND_API_KEY=
# Remetente verificado, ex.: portal@suaagencia.com.br
EMAIL_REMETENTE=

# Próximas fases (deixe em branco por enquanto)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASSINATURA_API_KEY=
# Segredo do webhook de assinatura (no mínimo 16 caracteres)
ASSINATURA_WEBHOOK_SECRET=
CRON_SECRET=
SENTRY_DSN=

# E-mail em desenvolvimento: SMTP da caixa de teste do Supabase local (http://127.0.0.1:54324)
EMAIL_SMTP_URL=smtp://127.0.0.1:54325
# Assinatura eletrônica: "simulado" só funciona fora de produção
ASSINATURA_PROVEDOR=simulado
