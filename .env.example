# Copie para .env.local e preencha. Nunca grave chaves reais no repositório.

# Endereço público do sistema (usado nos links dos e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API). Em ambiente local, rode `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: só no servidor. Nunca use NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY=
# Conexão direta ao Postgres, usada pelos testes de RLS
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Próximas fases (deixe em branco por enquanto)
RESEND_API_KEY=
EMAIL_REMETENTE=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASSINATURA_API_KEY=
ASSINATURA_WEBHOOK_SECRET=
CRON_SECRET=
SENTRY_DSN=
